# Environment Variables for GraphQL Mesh BFF

# Server Configuration
PORT=8080
HOST=0.0.0.0
ENABLE_PLAYGROUND=true

# CORS Configuration
CORS_ORIGINS=*

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
CACHE_TTL=300

# Service URLs - Update based on your environment
# These should match the services defined in .meshrc.yaml
LEARN_GO_SERVICE_URL=http://localhost:8001
LEARN_PYTHON_SERVICE_URL=http://localhost:8000
LEARN_RUST_SERVICE_URL=http://localhost:8080

# Authentication (forwarded to backend services)
# x-user-id header is automatically forwarded to all services

# Logging
LOG_LEVEL=info
NODE_ENV=development
